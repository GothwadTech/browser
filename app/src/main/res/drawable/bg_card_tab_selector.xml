<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/app_surface_sunken" />
            <stroke android:width="2.5dp" android:color="@color/app_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/app_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/app_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/app_surface_sunken" />
            <stroke android:width="1dp" android:color="@color/app_outline" />
        </shape>
    </item>
</selector>
