<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNativeHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/top_bar_background"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Main Content Area: 4-Column Grid with infinite vertical scrolling, full width without sidebar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookmarks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        android:scrollbars="vertical" />

    <!-- Chrome Incognito Landing View -->
    <ScrollView
        android:id="@+id/svIncognitoHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llIncognitoHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="28dp"
            android:paddingBottom="48dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <!-- Big Circular Icon with Spy Glasses -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_incognito_circle">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_incognito"
                    android:tint="#E8EAED"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Main Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings_native_home_you_ve_gone_incognito"
                android:textColor="@color/app_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="700dp"
                android:gravity="center"
                android:text="@string/settings_native_home_now_you_can_browse"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <!-- Chrome Details 2-Column Info Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxWidth="750dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Left Card: Chrome won't save -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_incognito_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_native_home_chrome_won_t_save"
                        android:textColor="@color/app_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/settings_native_home_your_browsing_history"
                        android:textColor="@color/app_on_surface_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_native_home_cookies_and_site_data"
                        android:textColor="@color/app_on_surface_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_native_home_information_entered_in_forms"
                        android:textColor="@color/app_on_surface_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Right Card: Activity might still be visible to -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_incognito_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_native_home_your_activity_might_still"
                        android:textColor="@color/app_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/settings_native_home_websites_you_visit"
                        android:textColor="@color/app_on_surface_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_native_home_your_employer_or_school"
                        android:textColor="@color/app_on_surface_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/settings_native_home_your_internet_service_provider"
                        android:textColor="@color/app_on_surface_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Exit Incognito Button -->
            <Button
                android:id="@+id/btnExitIncognito"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_bg_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/settings_native_home_close_incognito_mode"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
