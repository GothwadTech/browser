<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="32dp"
    android:background="@android:color/transparent">

    <!-- Card 1: App Brand & Identity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tv_setting_item"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/google_accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_tagline"
                    android:textColor="@color/google_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/gothwad_tech_desc"
            android:textColor="@color/google_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGithubLink"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/settings_version_github_com_gothwadtech_tvbrowser"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebsiteLink"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/settings_version_gothwadtech_com"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/app_accent" />

        <!-- Version & Engine Specs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_accent_badge_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/google_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Version: 1.0.0" />

            <TextView
                android:id="@+id/tvBuildFlavor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/google_text_secondary"
                android:textSize="12sp"
                tools:text="Build: generic · standard" />

            <TextView
                android:id="@+id/tvWebViewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/google_text_secondary"
                android:textSize="12sp"
                tools:text="Engine: Android System WebView" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card 2: Privacy & Local Architecture Guarantees -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tv_setting_item"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/settings_version_100_local_and_privacy"
            android:textColor="@color/google_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/settings_version_zero_tracking_no_telemetry"
            android:textColor="@color/app_on_surface_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Card 3: Legal & Gothwad Tech In-App Docs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tv_setting_item"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_version_legal_author_and_organization"
            android:textColor="@color/google_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Row 1: About Gothwad Tech & Privacy Policy (In-Built Native) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAboutGothwadTech"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/about_gothwad_title"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPrivacyPolicy"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/settings_version_privacy_policy_in_built"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 2: Terms & Conditions & License (In-Built Native) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTermsConditions"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/terms_and_conditions"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLicense"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/settings_version_open_source_license_mit"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 3: Support Author & Official Website -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSupportAuthor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/support_gothwad_tech"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOpenWebsite"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/settings_version_visit_gothwadtech_com"
                android:textColor="@color/google_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
