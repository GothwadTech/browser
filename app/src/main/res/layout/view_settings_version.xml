<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="32dp"
    android:background="@android:color/transparent">

    <!-- Card 1: App Brand & Identity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tv_setting_item"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gothwad Browser"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_tagline"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/gothwad_tech_desc"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGithubLink"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🐙 github.com/gothwadtech/tvbrowser"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWebsiteLink"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🌐 gothwadtech.com"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="#26344D" />

        <!-- Version & Engine Specs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_accent_badge_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Version: 1.0.0" />

            <TextView
                android:id="@+id/tvBuildFlavor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="Build: generic · standard" />

            <TextView
                android:id="@+id/tvWebViewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="Engine: Android System WebView" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card 2: Privacy & Local Architecture Guarantees -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_tv_setting_item"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="🛡️ 100% Local &amp; Privacy First"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="• Zero Tracking: No telemetry, no background analytics, and no remote data harvesting.\n• 100% Client-Side Local: All history, bookmarks, notes, and preferences remain solely on this device.\n• Open Source: Fully transparent architecture crafted by Gothwad Tech with zero server dependencies."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Card 3: Legal & Gothwad Tech In-App Docs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tv_setting_item"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="📜 Legal, Author &amp; Organization"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Row 1: About Gothwad Tech & Privacy Policy (In-Built Native) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAboutGothwadTech"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🏢 About Gothwad Tech"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPrivacyPolicy"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🔒 Privacy Policy (In-Built)"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 2: Terms & Conditions & License (In-Built Native) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTermsConditions"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="📜 Terms &amp; Conditions"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLicense"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="📃 Open Source License (MIT)"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 3: Support Author & Official Website -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSupportAuthor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="☕ Support Gothwad Tech"
                android:textColor="@color/selector_tv_tab_pill_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOpenWebsite"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_tab_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="🌐 Visit gothwadtech.com"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
