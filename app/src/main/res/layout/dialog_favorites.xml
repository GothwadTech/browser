<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llFavoritesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_left_sidebar"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Title & Subtitle Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookmarksTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bookmarks"
                android:textColor="@color/app_on_surface"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBookmarksSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_favorites_0_saved"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Right Action Controls -->
        <!-- Search Pill -->
        <LinearLayout
            android:id="@+id/llSearchContainer"
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_pill_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search_white"
                android:tint="#94A3B8"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/etSearchBookmarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search bookmarks"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:lines="1"
                android:textColor="@color/app_on_surface"
                android:textColorHint="@color/app_on_surface_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sort Pill Button -->
        <Button
            android:id="@+id/btnSortBookmarks"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@drawable/ic_sort_white"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/settings_favorites_recently_added"
            android:textAllCaps="false"
            android:textColor="@color/app_on_surface"
            android:textSize="12sp" />

        <!-- Add Bookmark Button -->
        <Button
            android:id="@+id/btnAddBookmark"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_pill_button"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/settings_favorites_add"
            android:textAllCaps="false"
            android:textColor="@color/app_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Close Button (X) -->
        <ImageButton
            android:id="@+id/ibCloseBookmarks"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_close_btn"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_grey_900_24dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Section Header Pill (All bookmarks / 1 item) -->
    <LinearLayout
        android:id="@+id/llSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_folder"
            android:tint="#0284C7"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_favorites_all_bookmarks"
            android:textColor="@color/app_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_favorites_0_items"
            android:textColor="@color/app_on_surface_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Content Area: RecyclerView or Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="#0284C7"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBookmarksGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/llEmptyBookmarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_star_filled_gold"
                android:tint="#94A3B8"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/no_bookmarks_yet"
                android:textColor="@color/app_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_favorites_bookmark_pages_to_easily"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
