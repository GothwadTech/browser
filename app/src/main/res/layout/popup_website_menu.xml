<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llWebsiteMenuRoot"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_popup_bg"
    android:paddingTop="6dp"
    android:paddingBottom="8dp"
    android:elevation="24dp"
    android:focusable="false">

    <!-- Top Quick Action Icons Row (Page Info / SSL, Bookmark Page, Refresh Page) -->
    <LinearLayout
        android:id="@+id/llWebMenuTopActions"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 1. Page Info & SSL Security Details -->
        <ImageButton
            android:id="@+id/btnWebMenuPageInfo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="@string/website_menu_site_info_and_security"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_info"
            android:tint="@color/day_night_icon_color" />

        <!-- 2. Bookmark Page -->
        <ImageButton
            android:id="@+id/btnWebMenuBookmark"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="@string/website_menu_bookmark_page"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_border_grey_900_36dp"
            android:tint="@color/day_night_icon_color" />

        <!-- 3. Refresh Page -->
        <ImageButton
            android:id="@+id/btnWebMenuRefresh"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="@string/refresh_page"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh_grey_900_24dp"
            android:tint="@color/day_night_icon_color" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@color/day_night_divider" />

    <!-- 🔎 Website Zoom Controls Section with Lens Icons & Live % -->
    <LinearLayout
        android:id="@+id/llWebsiteZoomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/website_menu_website_zoom"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Zoom Out Lens Button -->
            <ImageButton
                android:id="@+id/btnWebZoomOut"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:background="@drawable/menu_item_selector"
                android:contentDescription="@string/settings_pdf_viewer_zoom_out"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zoom_out_black_24dp"
                android:tint="@color/day_night_icon_color" />

            <!-- Live Zoom % Indicator Badge -->
            <TextView
                android:id="@+id/tvWebZoomPercent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="100%"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Zoom In Lens Button -->
            <ImageButton
                android:id="@+id/btnWebZoomIn"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:background="@drawable/menu_item_selector"
                android:contentDescription="@string/settings_pdf_viewer_zoom_in"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zoom_in_black_24dp"
                android:tint="@color/day_night_icon_color" />

            <!-- Quick Reset 100% Button -->
            <Button
                android:id="@+id/btnWebZoomReset"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/menu_item_selector"
                android:text="100%"
                android:textColor="@color/progressbar_tint"
                android:textSize="11sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@color/day_night_divider" />

    <!-- Scrollable Items Container -->
    <ScrollView
        android:id="@+id/svWebMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:scrollbars="none"
        android:focusable="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 1. New Tab -->
            <LinearLayout
                android:id="@+id/btnWebMenuNewTab"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_new_tab"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/bottom_toolbar_new_tab"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. Desktop Site Checkbox -->
            <RelativeLayout
                android:id="@+id/btnWebMenuDesktop"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/ivDesktopIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu_desktop"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/ivDesktopIcon"
                    android:layout_toStartOf="@+id/cbWebMenuDesktop"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:text="@string/chrome_menu_desktop_site"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbWebMenuDesktop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/progressbar_tint" />
            </RelativeLayout>

            <!-- 3. Find in page -->
            <LinearLayout
                android:id="@+id/btnWebMenuFindInPage"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_find"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/find_in_page"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 4. Share... -->
            <LinearLayout
                android:id="@+id/btnWebMenuShare"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_share"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/chrome_menu_share"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
