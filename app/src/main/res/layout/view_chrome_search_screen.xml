<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llSearchScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/day_night_background_color"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Unified Search Capsule Pill (Exactly Matching Screenshot: '+' inside pill on left, mic & lens on right) -->
    <LinearLayout
        android:id="@+id/llSearchUnifiedPill"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_search_pill_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <!-- 1. Left: back arrow (closes the search screen, like stock Chrome) -->
        <ImageButton
            android:id="@+id/ibSearchBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_grey_900_24dp"
            android:tint="@color/day_night_icon_color"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="@string/close_search"
            android:focusable="true"
            android:clickable="true" />

        <!-- 2. Middle: Search Input Text Box -->
        <EditText
            android:id="@+id/etSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/search_or_type_url"
            android:imeOptions="actionSearch"
            android:inputType="textFilter|textNoSuggestions|textUri"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:maxLines="1"
            android:textColor="#E3E3E3"
            android:textColorHint="#9AA0A6"
            android:textCursorDrawable="@null"
            android:textSize="15sp" />

        <!-- 3. Right: Clear 'X', Voice Search (Mic), Google Lens -->
        <LinearLayout
            android:id="@+id/llSearchPillActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clear 'X' -->
            <ImageButton
                android:id="@+id/ibSearchClear"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_grey_900_24dp"
                android:tint="#9AA0A6"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:contentDescription="Clear query"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <!-- Mic Icon -->
            <ImageButton
                android:id="@+id/ibSearchVoice"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic_none_grey_900_36dp"
                android:tint="#C4C7C5"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/voice_search"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Search Results Card Container (Background #1B1B1B, 24dp Rounded Corners, Cut Lines Between Items) -->
    <FrameLayout
        android:id="@+id/flSearchResultsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search_results_card"
        android:elevation="2dp"
        android:clipToOutline="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="ifContentScrolls"
            android:clipToPadding="false" />

        <!-- Empty state helper -->
        <TextView
            android:id="@+id/tvEmptySuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/search_suggestions_empty"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
