<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llChromeTabRoot"
    android:layout_width="145dp"
    android:layout_height="26dp"
    android:layout_gravity="center_vertical"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_chrome_tab_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="3dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/ivTabFavicon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@string/item_top_chrome_tab_tab_icon"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tab_default_favicon" />

    <TextView
        android:id="@+id/tvTabTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/shortcut_new_tab"
        android:includeFontPadding="false"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="11sp"
        tools:text="Google Search" />

    <ImageButton
        android:id="@+id/ibTabClose"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_chrome_close_btn"
        android:clickable="true"
        android:contentDescription="@string/item_sidebar_tab_close_tab"
        android:focusable="true"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_grey_900_24dp"
        android:tint="@color/day_night_icon_color" />

</LinearLayout>
