<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llTabItemRoot"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_card_tab_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Favicon + Active Badge + Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTabFavicon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_tab_default_favicon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvTabActiveBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/item_sidebar_tab_active"
            android:textColor="@color/app_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:id="@+id/vTabSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnTabClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_chrome_close_btn"
            android:clickable="true"
            android:contentDescription="@string/item_sidebar_tab_close_tab"
            android:focusable="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_grey_900_24dp"
            android:tint="@color/day_night_text_color_contrast" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTabTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/item_sidebar_tab_google_search"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTabUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/item_sidebar_favorite_google_com"
        android:textColor="@color/app_on_surface_muted"
        android:textSize="10sp" />
</LinearLayout>
