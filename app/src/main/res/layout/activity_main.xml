<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    android:background="@color/top_bar_background"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/top_bar_background"
        android:elevation="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Chrome Style Tab Bar -->
        <LinearLayout
            android:id="@+id/llTopTabBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="1dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- 1. Left: Down Arrow (Search Tabs / Recently Closed Tabs) - Directly above ibMenu -->
            <ImageButton
                android:id="@+id/ibTopTabSearch"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Search and Recently Closed Tabs"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_keyboard_arrow_down" />

            <!-- 2. Middle: Tabs RecyclerView with '+' button after the last tab -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopTabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:clipChildren="false" />

            <!-- New Tab '+' button in top tab bar (retained for binding compatibility, rendered inside rvTopTabs after last tab) -->
            <ImageButton
                android:id="@+id/ibTopNewTab"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/open_new_tab"
                android:focusable="false"
                android:src="@drawable/ic_add" />

            <!-- 3. Right: Up Arrow (Hide Header & Tab Bar) - Directly above ibIncognito -->
            <ImageButton
                android:id="@+id/ibTopHideBars"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Hide Header and Tab Bar"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_keyboard_arrow_up" />

            <!-- 4. Far Right: Cross / Close Icon (Complete App Shutdown) - Directly above ibSettings -->
            <ImageButton
                android:id="@+id/ibTopCloseApp"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="0dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Exit Browser Completely"
                android:focusable="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_close_grey_900_24dp" />
        </LinearLayout>

        <!-- Unified Main Header Toolbar -->
        <LinearLayout
            android:id="@+id/llMainToolbar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- 0. Menu (3-lines) -->
            <ImageButton
                android:id="@+id/ibMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Menu"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_menu_24" />

            <!-- 0.5. History -->
            <ImageButton
                android:id="@+id/ibHistory"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="History"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_history_grey_900_36dp" />

            <!-- 1. Home -->
            <ImageButton
                android:id="@+id/ibHome"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_home"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_home_grey_900_24dp" />

            <!-- 2. Back -->
            <ImageButton
                android:id="@+id/ibBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/back_icon_selector" />

            <!-- 3. Forward -->
            <ImageButton
                android:id="@+id/ibForward"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_forward"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/forward_icon_selector" />

            <!-- 4. Reload -->
            <ImageButton
                android:id="@+id/ibRefresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/refresh_page"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_refresh_grey_900_24dp" />

            <!-- 5. Search Bar (with Lock & Mic inside) -->
            <com.gothwad.browser.activity.main.view.ActionBar
                android:id="@+id/vActionBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp" />

            <!-- 6. Plus Icon (New Tab) -->
            <ImageButton
                android:id="@+id/ibNewTab"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/open_new_tab"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_add" />

            <!-- 7. Tab Icon (Chrome-style Tab Switcher Rounded Square Badge with Tab Count) -->
            <FrameLayout
                android:id="@+id/flTabsSwitcher"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Tabs Overview"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:id="@+id/tvTabCountBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/chrome_tab_count_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/header_button_icon_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 8. TV Notes Icon (Placed right after Tab Count Box) -->
            <ImageButton
                android:id="@+id/ibNotes"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="TV Notes"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_nav_notes" />

            <!-- 9. Download Icon -->
            <ImageButton
                android:id="@+id/ibDownloads"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Downloads"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_file_download_grey_900" />

            <!-- 10. File Manager Icon (Placed right after Downloads) -->
            <ImageButton
                android:id="@+id/ibFileManager"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="File Manager"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_nav_files" />

            <!-- 11. Bookmark Icon -->
            <ImageButton
                android:id="@+id/ibBookmarks"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Bookmarks"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_star_border_grey_900_36dp" />

            <!-- 12. Incognito Icon -->
            <ImageButton
                android:id="@+id/ibIncognito"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Incognito Mode"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_incognito" />

            <!-- 13. Settings Icon (At the far right end) -->
            <ImageButton
                android:id="@+id/ibSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/header_button_icon_tint"
                android:src="@drawable/ic_settings_grey_900_24dp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:id="@+id/progressBar"
        android:layout_below="@+id/rlActionBar"
        android:elevation="7dp"
        android:progressTint="@color/progressbar_tint"
        android:visibility="gone" />

    <com.gothwad.browser.widgets.cursor.CursorLayout
        android:id="@+id/flWebViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignParentBottom="true" />

    <com.gothwad.browser.activity.main.view.home.NativeHomeView
        android:id="@+id/vNativeHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignParentBottom="true"
        android:background="@color/top_bar_background"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rlActionBar"
        android:visibility="gone"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_add_box_24"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:visibility="gone" />
    
    <com.gothwad.browser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/progressbar_tint"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        />

</RelativeLayout>
