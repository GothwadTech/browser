<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llChromeMenuRoot"
    android:layout_width="185dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_popup_bg"
    android:paddingTop="5dp"
    android:paddingBottom="6dp"
    android:elevation="16dp"
    android:focusable="false">

    <!-- Top Quick Action Icons Row (App Lock, Page Info, Refresh) -->
    <LinearLayout
        android:id="@+id/llTopActionsRow"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 1. App Lock / Security PIN -->
        <ImageButton
            android:id="@+id/btnMenuAppLock"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="App Lock Security"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/btnMenuAppLock"
            android:nextFocusRight="@+id/btnMenuPageInfo"
            android:nextFocusDown="@+id/btnMenuNewTab"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lock_security"
            android:tint="@color/day_night_icon_color" />

        <!-- 2. Page Info & SSL Security Details -->
        <ImageButton
            android:id="@+id/btnMenuPageInfo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="Site Info"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/btnMenuAppLock"
            android:nextFocusRight="@+id/btnMenuRefresh"
            android:nextFocusDown="@+id/btnMenuNewTab"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_info"
            android:tint="@color/day_night_icon_color" />

        <!-- 3. Refresh Page -->
        <ImageButton
            android:id="@+id/btnMenuRefresh"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="Refresh page"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/btnMenuPageInfo"
            android:nextFocusRight="@+id/btnMenuRefresh"
            android:nextFocusDown="@+id/btnMenuNewTab"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh_grey_900_24dp"
            android:tint="@color/day_night_icon_color" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@color/day_night_divider" />

    <!-- Scrollable Items Container -->
    <ScrollView
        android:id="@+id/svMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 1. New Tab -->
            <LinearLayout
                android:id="@+id/btnMenuNewTab"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/btnMenuAppLock"
                android:nextFocusDown="@+id/btnMenuIncognito"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_new_tab"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="New tab"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. New Incognito Tab -->
            <LinearLayout
                android:id="@+id/btnMenuIncognito"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/btnMenuNewTab"
                android:nextFocusDown="@+id/btnMenuClipboard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/ivMenuIncognito"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_incognito"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvMenuIncognito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="New Incognito tab"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@color/day_night_divider" />

            <!-- 3. History -->
            <LinearLayout
                android:id="@+id/btnMenuHistory"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/btnMenuIncognito"
                android:nextFocusDown="@+id/btnMenuShare"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_history_grey_900_36dp"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="History"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 7. Share... -->
            <LinearLayout
                android:id="@+id/btnMenuShare"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/btnMenuHistory"
                android:nextFocusDown="@+id/btnMenuDesktop"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_share"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Share..."
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 8. Desktop site -->
            <RelativeLayout
                android:id="@+id/btnMenuDesktop"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/btnMenuShare"
                android:nextFocusDown="@+id/btnMenuHelp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/ivDesktopIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu_desktop"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/ivDesktopIcon"
                    android:layout_toStartOf="@+id/cbDesktopSite"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:text="Desktop site"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbDesktopSite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/day_night_list_focused_background_color" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@color/day_night_divider" />

            <!-- 9. Help & feedback -->
            <LinearLayout
                android:id="@+id/btnMenuHelp"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@+id/btnMenuDesktop"
                android:nextFocusDown="@+id/btnMenuHelp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_help"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Help &amp; feedback"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
