<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_left_sidebar"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top PC Chrome Header Bar -->
    <LinearLayout
        android:id="@+id/llHistoryHeader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Chrome Brand & Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/tv_shortcut_icon_bg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_history_grey_900_36dp"
                    android:tint="#38BDF8"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history"
                android:textColor="@color/app_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Standard Search Container -->
        <LinearLayout
            android:id="@+id/llHistorySearchContainer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_chrome_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_search_white"
                android:tint="#94A3B8"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/etSearchHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search history"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:lines="1"
                android:textColor="@color/app_on_surface"
                android:textColorHint="@color/app_on_surface_muted"
                android:textSize="13sp" />

            <!-- Clear Search Query Button -->
            <ImageButton
                android:id="@+id/ibClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/activity_history_clear_search"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close_grey_900_24dp"
                android:tint="#94A3B8"
                android:visibility="gone" />

            <!-- Voice Search Button -->
            <ImageButton
                android:id="@+id/ibVoiceSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/voice_search"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic_none_grey_900_36dp"
                android:tint="#38BDF8" />
        </LinearLayout>

        <!-- Multi-select Action Bar (Revealed when items selected) -->
        <LinearLayout
            android:id="@+id/llSelectionBar"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSelectedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/activity_history_1_selected"
                android:textColor="@color/app_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCancelSelection"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/button_bg_selector"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Close Button (X) -->
        <ImageButton
            android:id="@+id/ibHistoryBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_round_close_btn"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_grey_900_24dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Main 2-Pane Split Body (PC Chrome Layout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Chrome Navigation Drawer / Sidebar -->
        <LinearLayout
            android:id="@+id/llHistorySidebar"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_chrome_history_header"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- "Chrome history" Tab -->
            <LinearLayout
                android:id="@+id/llNavChromeHistory"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_chrome_history_sidebar_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_clock_cyan"
                    android:tint="#38BDF8"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/activity_history_chrome_history"
                    android:textColor="@color/app_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Filter Options Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:text="@string/activity_history_filters"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Filter: All Time -->
            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_chrome_history_sidebar_item"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/activity_history_all_time"
                android:textAllCaps="false"
                android:textColor="@color/app_accent"
                android:textSize="12sp" />

            <!-- Filter: Today -->
            <Button
                android:id="@+id/btnFilterToday"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_chrome_history_sidebar_item"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/activity_history_today"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="12sp" />

            <!-- Filter: Yesterday -->
            <Button
                android:id="@+id/btnFilterYesterday"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_chrome_history_sidebar_item"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/activity_history_yesterday"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="12sp" />

            <!-- Filter: Older -->
            <Button
                android:id="@+id/btnFilterOlder"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_chrome_history_sidebar_item"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/activity_history_older"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/app_surface_elevated" />

            <!-- Clear Browsing Data Button -->
            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/activity_history_clear_browsing_data"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface"
                android:textSize="12sp" />

            <!-- Filler View -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Stats Subtitle -->
            <TextView
                android:id="@+id/tvHistorySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/activity_history_0_visits_recorded"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Right Main Content: PinnedSectionListView / Empty View -->
        <FrameLayout
            android:id="@+id/flHistoryListContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1">

            <de.halfbit.pinnedsection.PinnedSectionListView
                android:id="@+id/listView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:listSelector="@drawable/list_item_bg_selector"
                android:scrollbars="vertical" />

            <!-- Empty State (Chrome Style) -->
            <LinearLayout
                android:id="@+id/llEmptyHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/tv_shortcut_icon_bg">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_history_grey_900_36dp"
                        android:tint="#38BDF8"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/activity_history_your_browsing_history_appears"
                    android:textColor="@color/app_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/activity_history_websites_you_visit_in"
                    android:textColor="@color/app_on_surface_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
