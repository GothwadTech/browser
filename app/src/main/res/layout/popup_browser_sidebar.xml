<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llBrowserSidebarRoot"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_popup_bg"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:elevation="24dp"
    android:focusable="false">

    <!-- Header / Brand Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_gothwad_logo"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browser Menu"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast TV Navigation"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/day_night_divider" />

    <!-- Scrollable Navigation Items -->
    <ScrollView
        android:id="@+id/svSidebarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp"
        android:scrollbars="none"
        android:focusable="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!-- 1. File Manager -->
            <LinearLayout
                android:id="@+id/btnSidebarFileManager"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_files"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="File Manager"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Bookmarks -->
            <LinearLayout
                android:id="@+id/btnSidebarBookmarks"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_star_border_grey_900_36dp"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Bookmarks"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 3. History -->
            <LinearLayout
                android:id="@+id/btnSidebarHistory"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history_grey_900_36dp"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="History"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 4. Downloads -->
            <LinearLayout
                android:id="@+id/btnSidebarDownloads"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_file_download_grey_900"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Downloads"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 5. Notes -->
            <LinearLayout
                android:id="@+id/btnSidebarNotes"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_notes"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Notes"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 6. Native Clipboard -->
            <LinearLayout
                android:id="@+id/btnSidebarClipboard"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_clipboard"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Clipboard"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 7. Incognito Mode -->
            <LinearLayout
                android:id="@+id/btnSidebarIncognito"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/ivSidebarIncognito"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_incognito"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvSidebarIncognito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Incognito Mode"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 8. App Lock Security -->
            <LinearLayout
                android:id="@+id/btnSidebarAppLock"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock_security"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="App Lock PIN"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:background="@color/day_night_divider" />

            <!-- App UI Zoom Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App UI Zoom"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnSidebarUiScale100"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/menu_item_selector"
                        android:text="100%"
                        android:textColor="@color/day_night_text_color_contrast"
                        android:textSize="11sp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btnSidebarUiScale125"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/menu_item_selector"
                        android:text="125%"
                        android:textColor="@color/day_night_text_color_contrast"
                        android:textSize="11sp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btnSidebarUiScale150"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:background="@drawable/menu_item_selector"
                        android:text="150%"
                        android:textColor="@color/day_night_text_color_contrast"
                        android:textSize="11sp"
                        android:padding="0dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/day_night_divider" />

            <!-- 9. Settings -->
            <LinearLayout
                android:id="@+id/btnSidebarSettings"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings_grey_900_24dp"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Settings"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 10. Help & feedback -->
            <LinearLayout
                android:id="@+id/btnSidebarHelp"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_help"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="About &amp; Help"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
