<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llChromeTabSwitcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/top_bar_background"
    android:clickable="true"
    android:focusable="true">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/rlTabSwitcherHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 1. Left: '+' New Tab Button (Blue Rounded Square) -->
        <ImageButton
            android:id="@+id/btnNewTabTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chrome_new_tab_btn"
            android:src="@drawable/ic_add"
            android:tint="#041E49"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="New tab"
            android:focusable="true"
            android:clickable="true" />

        <!-- 2. Center: Segmented Toggle Pill (Open Tabs vs Tab Groups) -->
        <LinearLayout
            android:id="@+id/llSegmentedToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_chrome_tabs_segmented"
            android:orientation="horizontal"
            android:padding="2dp">

            <!-- Segment 1: Open Tabs Count -->
            <FrameLayout
                android:id="@+id/btnSegmentOpenTabs"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chrome_segment_selected"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSegmentTabCount"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/chrome_tab_count_badge"
                    android:gravity="center"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="11" />
            </FrameLayout>

            <!-- Segment 2: Tab Groups Grid -->
            <FrameLayout
                android:id="@+id/btnSegmentGroups"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSegmentGridIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_view_grid"
                    android:tint="@color/day_night_text_secondary"
                    android:scaleType="fitCenter"
                    android:contentDescription="Tab groups" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3. Right: 3-Dot Overflow Menu Button -->
        <ImageButton
            android:id="@+id/btnTabsOverflowMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_selector"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/day_night_icon_color"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="More tab options"
            android:focusable="true"
            android:clickable="true" />
    </RelativeLayout>

    <!-- Search Your Tabs Pill -->
    <FrameLayout
        android:id="@+id/flSearchTabsPill"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/chrome_omnibox_bg">

        <EditText
            android:id="@+id/etSearchTabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="Search your tabs"
            android:imeOptions="actionSearch"
            android:inputType="textFilter|textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:maxLines="1"
            android:textColor="@color/day_night_text_color_contrast"
            android:textColorHint="@color/day_night_text_secondary"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Main Content Area: Tabs Grid View vs Groups View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Open Tabs 2-Column Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChromeTabsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <!-- 2. Groups / Inactive Tabs View (Screenshot 2) -->
        <LinearLayout
            android:id="@+id/llTabGroupsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <!-- Tab Group Card (Matching Screenshot 2) -->
            <LinearLayout
                android:id="@+id/llSampleTabGroupCard"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_tab_card_normal"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <!-- 2x2 Mini Preview -->
                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_search_results_card"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivGroupMini1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="2dp"
                            android:src="@drawable/ic_tab_default_favicon" />

                        <ImageView
                            android:id="@+id/ivGroupMini2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="2dp"
                            android:src="@drawable/ic_tab_default_favicon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivGroupMini3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="2dp"
                            android:src="@drawable/ic_tab_default_favicon" />

                        <ImageView
                            android:id="@+id/ivGroupMini4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="2dp"
                            android:src="@drawable/ic_tab_default_favicon" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGroupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● 1 tab group"
                        android:textColor="@color/day_night_text_color_contrast"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGroupSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Open tab group"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnGroupOptions"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/day_night_text_secondary"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:contentDescription="Group options" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
