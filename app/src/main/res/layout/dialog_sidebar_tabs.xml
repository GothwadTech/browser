<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flTabsSidebarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/vTabsBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Right Side Drawer Panel -->
    <LinearLayout
        android:id="@+id/llTabsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_tv_right_sidebar"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Top Header with Back Button, Title, + New Tab, and Close All -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnTabsBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_side_back_btn"
                android:clickable="true"
                android:contentDescription="@string/settings_sidebar_tabs_close_tabs"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back_grey_900_24dp"
                android:tint="@color/selector_tv_side_back_icon" />

            <TextView
                android:id="@+id/tvTabsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/settings_sidebar_tabs_open_tabs"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddNewTab"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/settings_sidebar_tabs_new"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseAllTabs"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pill_button"
                android:focusable="true"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/settings_sidebar_tabs_close_all"
                android:textAllCaps="false"
                android:textColor="@color/app_on_surface_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2-Column Grid RecyclerView for Tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTabsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="true"
            android:scrollbars="vertical" />
    </LinearLayout>
</FrameLayout>
