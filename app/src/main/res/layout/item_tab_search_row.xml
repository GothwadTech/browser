<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llTabSearchRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_chrome_history_sidebar_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivTabSearchFavicon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tab_default_favicon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTabSearchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Google Search" />

        <TextView
            android:id="@+id/tvTabSearchUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="11sp"
            tools:text="https://www.google.com" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTabSearchActiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_pill_button"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/item_sidebar_tab_active"
        android:textColor="@color/app_on_surface"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/ibTabSearchClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_chrome_close_btn"
        android:clickable="true"
        android:contentDescription="@string/item_sidebar_tab_close_tab"
        android:focusable="true"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_grey_900_24dp"
        android:tint="@color/day_night_icon_color" />

</LinearLayout>
