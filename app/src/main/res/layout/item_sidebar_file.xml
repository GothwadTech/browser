<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llFileItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_sleek"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivFileIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_folder"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="@string/download"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/item_sidebar_file_12_items_today"
            android:textColor="@color/app_on_surface_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFileOptions"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_tv_side_back_btn"
        android:clickable="true"
        android:contentDescription="@string/item_sidebar_file_file_options"
        android:focusable="true"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete_grey_400_24dp"
        android:tint="@color/day_night_text_color_contrast" />
</LinearLayout>
