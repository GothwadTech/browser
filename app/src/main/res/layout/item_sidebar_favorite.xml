<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llFavItemRoot"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_card_tab_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Favicon + Delete Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivFavIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_tab_default_favicon"
            android:contentDescription="@null" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFavDelete"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_tv_side_back_btn"
            android:clickable="true"
            android:contentDescription="@string/item_sidebar_favorite_delete_bookmark"
            android:focusable="true"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete_grey_400_24dp"
            android:tint="@color/day_night_text_color_contrast" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFavTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/item_sidebar_favorite_google"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFavUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/item_sidebar_favorite_google_com"
        android:textColor="@color/app_on_surface_muted"
        android:textSize="10sp" />
</LinearLayout>
