<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/day_night_background_color"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvTabsHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_sidebar_tabs_open_tabs"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- New Tab Action Button -->
        <Button
            android:id="@+id/btnNewTabAction"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/settings_tab_search_dropdown_new_tab"
            android:textAllCaps="false"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Close All Action Button -->
        <Button
            android:id="@+id/btnCloseAllTabs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/settings_sidebar_tabs_close_all"
            android:textAllCaps="false"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="13sp" />

        <!-- Done / Dismiss Button -->
        <Button
            android:id="@+id/btnDoneTabs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/done"
            android:textAllCaps="false"
            android:textColor="@color/progressbar_tint"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/day_night_divider" />

    <!-- Grid of open tabs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
</LinearLayout>
